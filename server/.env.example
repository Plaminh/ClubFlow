# Copy this file to server/.env (never commit .env). Every variable is required.

# Port the API listens on, on every interface. The Vite proxy forwards /api to 3001.
PORT=3001

# PostgreSQL connection string. The only setting used to find the database.
# This example is the local docker-compose database (no password, bound to localhost).
DATABASE_URL=postgres://clubflow@localhost:5433/clubflow

# Secret that signs sign-in tokens. Use a long random value, for example the output of
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-value

# Token lifetime: minutes or hours, at most 24h.
JWT_EXPIRES_IN=8h

# Folder for uploaded CVs, relative to server/. Outside src/ and ignored by git.
UPLOAD_DIR=./uploads

# The business date "today" (YYYY-MM-DD). Inside the seeded campaign's application period.
APP_TODAY=2026-11-18
