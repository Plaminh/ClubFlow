{
  "name": "clubflow-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "migrate": "node --env-file-if-exists=.env src/db/migrate.js",
    "seed": "node --env-file-if-exists=.env src/db/seed.js",
    "test": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run",
    "test:watch": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs",
    "test:coverage": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run --coverage"
  },
  "dependencies": {
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.3",
    "supertest": "^7.3.1",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.9"
  }
}
