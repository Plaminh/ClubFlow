{
  "name": "clubflow",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "client"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "test": "npm run test:run --workspace client && npm run test:mock",
    "test:frontend": "npm run test --workspace client",
    "test:mock": "vitest run --config mock/vitest.config.mjs",
    "mock": "node mock/server.mjs",
    "verify:mock-http": "node tools/verify-pa3-http.mjs",
    "lint": "eslint .",
    "verify": "npm run lint && npm run test && npm run build",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:server": "npm --prefix server run dev",
    "test:server": "npm --prefix server test"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "3.10.1"
  }
}
